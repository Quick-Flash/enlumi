{
  "version": 1,
  "name": "Betaflight 2026.6 motor 1",
  "requires_settings": [
    {
      "setting": {
        "name": "Firmware revision"
      },
      "starts_with": "Betaflight 2026.6."
    }
  ],
  "signals": [
    {
      "id": "electrical",
      "source": "blackbox/1/eRPM[0]",
      "metadata": {
        "name": "Motor 1 logged eRPM",
        "unit": "100 eRPM"
      }
    }
  ],
  "filters": [
    {
      "id": "rpm",
      "metadata": {
        "name": "Motor 1 mechanical RPM",
        "unit": "rpm"
      },
      "inputs": [
        "$electrical"
      ],
      "operation": {
        "kind": "affine",
        "gain": {
          "ratio": [
            200,
            {
              "setting": {
                "name": "motor_poles"
              }
            }
          ]
        }
      }
    },
    {
      "id": "hz",
      "metadata": {
        "name": "Motor 1 rotational frequency",
        "unit": "Hz"
      },
      "inputs": [
        "$rpm"
      ],
      "operation": {
        "kind": "affine",
        "gain": {
          "ratio": [
            1,
            60
          ]
        }
      }
    }
  ],
  "views": [
    {
      "name": "Mechanical RPM",
      "fields": [
        "$rpm"
      ]
    },
    {
      "name": "Rotation frequency",
      "fields": [
        "$hz"
      ]
    }
  ],
  "auto_apply": false,
  "requires": [
    "blackbox/1/eRPM[0]"
  ]
}
